# Mock WhatsApp demo. Set APP_MODE=live when a public Meta webhook is ready.
APP_MODE=mock
HOST=0.0.0.0
PORT=8765
PUBLIC_BASE_URL=http://127.0.0.1:8765

# Default LLM: Groq free tier, OpenAI-compatible chat completions.
# Create a key at https://console.groq.com/keys
# Leave GROQ_API_KEY blank to run the demo on the local fact-locked writer.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional providers. Set LLM_PROVIDER to openai, gemini, anthropic, or local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# WhatsApp Cloud API. Required only when APP_MODE=live.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=safu-verify
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Order state only. CV text is never written here.
# memory: process memory. sqlite: local file (used on Render). supabase: needs the keys below.
ORDER_STORE=memory
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Payment. stub (demo, reply PAY), mpesa (Daraja sandbox STK), or paystack (test checkout).
# Documents are sent only after payment is confirmed. Set REQUIRE_PAYMENT=false to skip that.
PAYMENT_PROVIDER=stub
REQUIRE_PAYMENT=true
PRICE_AMOUNT=1500
PRICE_CURRENCY=KES

# Safaricom Daraja sandbox: https://developer.safaricom.co.ke
# Sandbox shortcode is 174379. Copy the passkey from the simulator page.
# Leave MPESA_ENV=sandbox until you have production credentials.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Optional. Default callback is {PUBLIC_BASE_URL}/webhooks/mpesa
MPESA_CALLBACK_URL=
# Optional shared secret appended to the callback URL as ?token=
MPESA_CALLBACK_SECRET=

# Paystack test secret (sk_test_...). Live keys are refused unless PAYSTACK_ALLOW_LIVE=true.
# Webhook URL: {PUBLIC_BASE_URL}/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_ALLOW_LIVE=false

# Generated files are deleted this many seconds after a successful delivery.
FILE_TTL_SECONDS=1800
# One follow-up is sent this many hours after an unfinished order goes quiet.
# Live WhatsApp uses the approved template WHATSAPP_FOLLOWUP_TEMPLATE (free text is blocked after 24h).
FOLLOWUP_AFTER_HOURS=48
WHATSAPP_FOLLOWUP_TEMPLATE=safu_followup_48h
WHATSAPP_TEMPLATE_LANGUAGE=en
# Undelivered working files are deleted after this many seconds.
MAX_HOLD_SECONDS=172800

# Photo reading. auto = Groq vision when GROQ_API_KEY is set, then Tesseract if that fails.
# tesseract = local binary only. The free Render Python service has no Tesseract; vision covers it.
OCR_PROVIDER=auto
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Alerts. With none of these set, alerts stay in demo mode (log + memory only).
# Gmail: smtp.gmail.com:465 using an app password, delivered to OWNER_EMAIL.
GMAIL_USER=
GMAIL_APP_PASSWORD=
OWNER_EMAIL=
# Optional Telegram bot. Create it with @BotFather and put the chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Slack (or other) incoming webhook. Payload has no CV text.
ALERT_WEBHOOK_URL=

# Bearer token for /api/ops/*. Required when APP_MODE=live. Mock mode leaves the routes open until this is set.
ADMIN_TOKEN=
# Older name, still accepted as a bearer token.
OPS_TOKEN=
# Bearer token for POST /api/cron/tick (follow-ups, recovery, file sweep). ADMIN_TOKEN is also accepted.
CRON_SECRET=

# Mock mode allows localhost URL fetches so the sample job page works.
# Live mode blocks them unless this is true.
ALLOW_LOCAL_URLS=
LOG_LEVEL=INFO
BACKGROUND_TASKS=1
DATA_DIR=./var
