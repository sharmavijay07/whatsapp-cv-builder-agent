# Mock WhatsApp demo. Set APP_MODE=live when a public Meta webhook is ready.
APP_MODE=mock
HOST=0.0.0.0
PORT=8765
PUBLIC_BASE_URL=http://127.0.0.1:8765

# Default LLM: Groq free tier, OpenAI-compatible chat completions.
# Create a key at https://console.groq.com/keys
# Leave GROQ_API_KEY blank to run the demo on the local fact-locked writer.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional providers. Set LLM_PROVIDER to openai, gemini, anthropic, or local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# WhatsApp Cloud API. Required only when APP_MODE=live.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=safu-verify
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Order state only. CV text is never written here.
# memory: process memory. sqlite: local file (used on Render). supabase: needs the keys below.
ORDER_STORE=memory
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Payment is an interface. The default is a stub: no charge is made.
PAYMENT_PROVIDER=stub
PRICE_AMOUNT=1500
PRICE_CURRENCY=KES

# Generated files are deleted this many seconds after a successful delivery.
FILE_TTL_SECONDS=1800
# One follow-up is sent this many hours after an unfinished order goes quiet.
FOLLOWUP_AFTER_HOURS=48
# Undelivered working files are deleted after this many seconds.
MAX_HOLD_SECONDS=172800

# Optional Slack (or other) incoming webhook for alerts. Payload has no CV text.
ALERT_WEBHOOK_URL=
# Required to call /api/ops/* when APP_MODE=live. Mock mode leaves this open.
OPS_TOKEN=

# Mock mode allows localhost URL fetches so the sample job page works.
# Live mode blocks them unless this is true.
ALLOW_LOCAL_URLS=
LOG_LEVEL=INFO
BACKGROUND_TASKS=1
DATA_DIR=./var
